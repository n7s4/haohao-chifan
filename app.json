{
  "expo": {
    "name": "好好吃饭",
    "slug": "haohao-chifan",
    "scheme": "haohaochifan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wenxin.haohaochifan"
    },
    "android": {
      "package": "com.wenxin.haohaochifan",
      "adaptiveIcon": {
        "backgroundColor": "#F05133",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许「好好吃饭」访问相册，给菜谱添加成品图和步骤图。",
          "cameraPermission": "允许「好好吃饭」使用相机，拍下做好的菜和每一步。",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F05133"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "374b111b-9b55-4d87-9509-efbde6d019d7"
      }
    },
    "owner": "ethanwen"
  }
}
